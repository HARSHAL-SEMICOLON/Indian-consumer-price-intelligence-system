model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_ProTooling = ["DevMode"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table _Measures
ref table dim_date
ref table dim_product
ref table dim_brand
ref table dim_category
ref table dim_location
ref table dim_source
ref table dim_cpi_item
ref table bridge_commodity_cpi
ref table fact_price
ref table fact_availability
ref table fact_cpi_benchmark
ref table dq_check_summary
ref table dq_issue_log
ref table etl_raw_file
ref table etl_run
ref table price_spikes
ref table history_depth

	partition dq_issue_log = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\dq_issue_log.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Nulls = Table.TransformColumns(Promoted, List.Transform(Table.ColumnNames(Promoted), (c) => {c, each if _ = "" then null else _})),
				    Typed = Table.TransformColumnTypes(Nulls, {{"issue_id", Int64.Type}, {"run_id", Int64.Type}, {"source_code", type text}, {"record_key", type text}, {"price_id", Int64.Type}, {"check_name", type text}, {"severity", type text}, {"field", type text}, {"observed_value", type text}, {"action_taken", type text}, {"capture_file", type text}, {"logged_at_utc", type text}}, "en-US")
				in
				    Typed


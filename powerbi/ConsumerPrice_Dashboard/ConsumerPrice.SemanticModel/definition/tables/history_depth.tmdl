		sourceColumn: dated_points

	column daily_steps
		dataType: int64
		formatString: 0
		lineageTag: 488bccdf-2c94-5df5-b3fc-354648493979
		summarizeBy: none
		sourceColumn: daily_steps

	column first_date
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 75e66f0e-4b7f-5537-8179-01261e425b0e
		summarizeBy: none

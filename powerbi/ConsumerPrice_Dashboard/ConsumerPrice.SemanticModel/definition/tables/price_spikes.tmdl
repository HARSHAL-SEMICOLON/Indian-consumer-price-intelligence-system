	partition price_spikes = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\price_spikes.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Nulls = Table.TransformColumns(Promoted, List.Transform(Table.ColumnNames(Promoted), (c) => {c, each if _ = "" then null else _})),
				    Typed = Table.TransformColumnTypes(Nulls, {{"product_name", type text}, {"category", type text}, {"obs_date", type date}, {"prev_date", type date}, {"prev_price", type number}, {"price", type number}, {"normalized_unit", type text}, {"pct_change", type number}, {"normal_change", type number}, {"sd_change", type number}, {"z_score", type number}, {"spike_type", type text}, {"is_this_week", Int64.Type}, {"n_steps", Int64.Type}}, "en-US")
				in
				    Typed


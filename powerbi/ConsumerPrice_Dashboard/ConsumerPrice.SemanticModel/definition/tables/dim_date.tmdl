table dim_date
	lineageTag: 71d46b92-0fb8-5802-8dcc-8c28f7127452
	dataCategory: Time

	column date_key
		dataType: int64
		formatString: 0
		lineageTag: f6105420-6e55-5caa-8dd0-15e5494bde0d
		summarizeBy: none
		sourceColumn: date_key

	column full_date
		dataType: dateTime
		formatString: yyyy-mm-dd
		isKey
		lineageTag: f772da50-a742-5731-a447-b20358ab687b
		summarizeBy: none
		sourceColumn: full_date

	column year
		dataType: int64
		formatString: 0
		lineageTag: d47aa05d-869f-5820-8db2-932209ce53d0
		summarizeBy: none
		sourceColumn: year

	column quarter
		dataType: int64
		formatString: 0
		lineageTag: 8dc55711-70e9-553c-9d4f-a0a11b82065b
		summarizeBy: none
		sourceColumn: quarter

	column month
		dataType: int64
		formatString: 0
		lineageTag: e591f99f-0807-514f-bbaf-4b86a1cbcf85
		summarizeBy: none
		sourceColumn: month

	column month_name
		dataType: string
		lineageTag: fea7d750-77f9-553d-9261-e3b9c7db376b
		summarizeBy: none
		sourceColumn: month_name
		sortByColumn: month

	column year_month
		dataType: string
		lineageTag: 73e2bf84-8fed-537a-b855-212c5f3c1c33
		summarizeBy: none
		sourceColumn: year_month

	column iso_week
		dataType: int64
		formatString: 0
		lineageTag: 8ea20703-2a37-5f85-91a3-54de33ed3d07
		summarizeBy: none
		sourceColumn: iso_week

	column day_of_month
		dataType: int64
		formatString: 0
		lineageTag: f39bbcdf-f567-5793-8995-91aec0a1115c
		summarizeBy: none
		sourceColumn: day_of_month

	column day_name
		dataType: string
		lineageTag: 907e9ccf-66dd-5aff-8fba-dc7c43964cfa
		summarizeBy: none
		sourceColumn: day_name

	column is_weekend
		dataType: int64
		formatString: 0
		lineageTag: dadf5f99-2597-5ada-97b8-ef0f687417ee
		summarizeBy: none
		sourceColumn: is_weekend

	partition dim_date = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\dim_date.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Nulls = Table.TransformColumns(Promoted, List.Transform(Table.ColumnNames(Promoted), (c) => {c, each if _ = "" then null else _})),
				    Typed = Table.TransformColumnTypes(Nulls, {{"date_key", Int64.Type}, {"full_date", type date}, {"year", Int64.Type}, {"quarter", Int64.Type}, {"month", Int64.Type}, {"month_name", type text}, {"year_month", type text}, {"iso_week", Int64.Type}, {"day_of_month", Int64.Type}, {"day_name", type text}, {"is_weekend", Int64.Type}}, "en-US")
				in
				    Typed


// Generated by powerbi/generate_powerbi_project.py - the same measures are inside ConsumerPrice.SemanticModel.
// Prices are normalised: INR per kg, per litre or per unit - never mix units in one visual.


// ---------- 1 Core ----------
Observations =
COUNTROWS ( fact_price )
// format: #,0

Avg Normalized Price =
AVERAGE ( fact_price[normalized_price] )
// format: ₹ #,0.00

Median Normalized Price =
MEDIAN ( fact_price[normalized_price] )
// format: ₹ #,0.00

Min Normalized Price =
MIN ( fact_price[normalized_price] )
// format: ₹ #,0.00

Max Normalized Price =
MAX ( fact_price[normalized_price] )
// format: ₹ #,0.00

Distinct Products =
DISTINCTCOUNT ( fact_price[product_key] )
// format: #,0

Commodities Tracked =
CALCULATE ( DISTINCTCOUNT ( fact_price[product_key] ), dim_source[source_code] = "DOCA_PMD" )
// format: #,0

Branded Products Observed =
CALCULATE ( DISTINCTCOUNT ( fact_price[product_key] ), dim_source[source_code] = "OPEN_PRICES" )
// format: #,0

Cities Covered =
CALCULATE ( COUNTROWS ( FILTER ( SUMMARIZE ( fact_price, dim_location[city] ), NOT ISBLANK ( dim_location[city] ) ) ), dim_location[location_level] = "outlet" )
// format: #,0

Latest Collection Date =
VAR k = MAX ( fact_price[collection_date_key] )
RETURN IF ( NOT ISBLANK ( k ), DATE ( INT ( k / 10000 ), MOD ( INT ( k / 100 ), 100 ), MOD ( k, 100 ) ) )
// format: dd-mmm-yyyy


// ---------- 2 Time comparisons ----------
Latest Obs Date =
CALCULATE ( MAX ( fact_price[date_key] ), REMOVEFILTERS ( dim_date ) )
// format: 0

Price Latest =
VAR d = [Latest Obs Date]
RETURN CALCULATE ( [Avg Normalized Price], REMOVEFILTERS ( dim_date ), fact_price[date_key] = d )
// format: ₹ #,0.00

Price 1M Ago =
VAR k = [Latest Obs Date]
VAR t = IF ( NOT ISBLANK ( k ), EDATE ( DATE ( INT ( k / 10000 ), MOD ( INT ( k / 100 ), 100 ), MOD ( k, 100 ) ), -1 ) )
RETURN IF ( NOT ISBLANK ( t ), CALCULATE ( [Avg Normalized Price], REMOVEFILTERS ( dim_date ),
    dim_date[full_date] >= t - 7, dim_date[full_date] <= t ) )
// format: ₹ #,0.00

Price 1Y Ago =
VAR k = [Latest Obs Date]
VAR t = IF ( NOT ISBLANK ( k ), EDATE ( DATE ( INT ( k / 10000 ), MOD ( INT ( k / 100 ), 100 ), MOD ( k, 100 ) ), -12 ) )
RETURN IF ( NOT ISBLANK ( t ), CALCULATE ( [Avg Normalized Price], REMOVEFILTERS ( dim_date ),
    dim_date[full_date] >= t - 7, dim_date[full_date] <= t ) )
// format: ₹ #,0.00

MoM Change % =
DIVIDE ( [Price Latest] - [Price 1M Ago], [Price 1M Ago] )
// format: 0.0%

YoY Change % =
DIVIDE ( [Price Latest] - [Price 1Y Ago], [Price 1Y Ago] )
// format: 0.0%

Avg YoY Change % (DoCA) =
AVERAGEX ( VALUES ( dim_product[product_key] ),
    CALCULATE ( [YoY Change %], dim_source[source_code] = "DOCA_PMD", fact_price[price_type] = "retail" ) )
// format: 0.0%

Avg MoM Change % (DoCA) =
AVERAGEX ( VALUES ( dim_product[product_key] ),
    CALCULATE ( [MoM Change %], dim_source[source_code] = "DOCA_PMD", fact_price[price_type] = "retail" ) )
// format: 0.0%

Price CV % =
DIVIDE ( STDEVX.P ( fact_price, fact_price[normalized_price] ), [Avg Normalized Price] )
// format: 0.0%

CPI Index (mapped item) =
VAR items =
    CALCULATETABLE ( VALUES ( bridge_commodity_cpi[cpi_item_key] ),
        TREATAS ( VALUES ( dim_product[product_key] ), bridge_commodity_cpi[product_key] ) )
RETURN CALCULATE ( AVERAGE ( fact_cpi_benchmark[index_value] ), TREATAS ( items, fact_cpi_benchmark[cpi_item_key] ) )
// format: 0.0


// ---------- 3 Brands ----------
Brands in Selection =
DISTINCTCOUNT ( fact_price[brand_key] )
// format: #,0

Sample Flag =
IF ( [Observations] >= 3, "ok", "low sample (<3 obs)" )



// ---------- 4 Locations ----------
Cities for Product =
COUNTROWS ( FILTER ( SUMMARIZE ( fact_price, dim_location[city] ), NOT ISBLANK ( dim_location[city] ) ) )
// format: #,0

Min Pack Price =
MIN ( fact_price[price_paid] )
// format: ₹ #,0.00

Max Pack Price =
MAX ( fact_price[price_paid] )
// format: ₹ #,0.00

Location Spread % =
DIVIDE ( [Max Pack Price] - [Min Pack Price], [Min Pack Price] )
// format: 0.0%

City Price Index =
VAR t =
    ADDCOLUMNS (
        fact_price,
        "@ref", CALCULATE ( AVERAGE ( fact_price[normalized_price] ), ALLEXCEPT ( fact_price, fact_price[product_key] ) ),
        "@cities", CALCULATE ( COUNTROWS ( FILTER ( SUMMARIZE ( fact_price, dim_location[city] ), NOT ISBLANK ( dim_location[city] ) ) ), ALLEXCEPT ( fact_price, fact_price[product_key] ) )
    )
RETURN IF ( NOT ISBLANK ( SELECTEDVALUE ( dim_location[city] ) ), 100 * AVERAGEX ( FILTER ( t, [@cities] >= 2 && NOT ISBLANK ( fact_price[normalized_price] ) ),
    DIVIDE ( fact_price[normalized_price], [@ref] ) ) )
// format: 0.0

Retail Markup over Wholesale % =
VAR d = [Latest Obs Date]
VAR r = CALCULATE ( [Avg Normalized Price], fact_price[price_type] = "retail", fact_price[date_key] = d )
VAR w = CALCULATE ( [Avg Normalized Price], fact_price[price_type] = "wholesale" )
RETURN DIVIDE ( r - w, w )
// format: 0.0%


// ---------- 5 Discounts & availability ----------
% Observations Discounted =
DIVIDE (
    CALCULATE ( COUNTROWS ( fact_price ), fact_price[is_discounted] = 1, NOT CONTAINSSTRING ( fact_price[dq_flags] & "", "implausible_list_price" ) ),
    CALCULATE ( COUNTROWS ( fact_price ), NOT CONTAINSSTRING ( fact_price[dq_flags] & "", "implausible_list_price" ) ) )
// format: 0.0%

Avg Discount % (when discounted) =
CALCULATE ( AVERAGE ( fact_price[discount_pct] ) / 100, fact_price[is_discounted] = 1,
    FILTER ( fact_price, fact_price[price_list] > fact_price[price_paid] ), NOT CONTAINSSTRING ( fact_price[dq_flags] & "", "implausible_list_price" ) )
// format: 0.0%

Total Savings INR =
CALCULATE ( SUMX ( fact_price, fact_price[price_list] - fact_price[price_paid] ),
    fact_price[is_discounted] = 1, NOT CONTAINSSTRING ( fact_price[dq_flags] & "", "implausible_list_price" ) )
// format: ₹ #,0

Avg Normalized List Price =
CALCULATE ( AVERAGE ( fact_price[normalized_list_price] ), fact_price[is_discounted] = 1,
    NOT CONTAINSSTRING ( fact_price[dq_flags] & "", "implausible_list_price" ) )
// format: ₹ #,0.00

Avg Normalized Effective Price =
CALCULATE ( AVERAGE ( fact_price[normalized_price] ), fact_price[is_discounted] = 1,
    NOT CONTAINSSTRING ( fact_price[dq_flags] & "", "implausible_list_price" ) )
// format: ₹ #,0.00

Availability Status =
SELECTEDVALUE ( fact_availability[availability_status] )


Not Reported Gap Rate % =
DIVIDE (
    CALCULATE ( COUNTROWS ( fact_availability ), fact_availability[availability_status] = "not_reported" ),
    CALCULATE ( COUNTROWS ( fact_availability ), fact_availability[availability_status] <> "not_yet_tracked" ) ) + 0
// format: 0.0%


// ---------- 6 Data quality ----------
Total Raw Records =
COUNTROWS ( fact_price )
// format: #,0

Records Included =
CALCULATE ( COUNTROWS ( fact_price ), fact_price[include_in_analysis] = 1 )
// format: #,0

Records Excluded =
CALCULATE ( COUNTROWS ( fact_price ), fact_price[include_in_analysis] = 0 ) + 0
// format: #,0

Records Flagged =
CALCULATE ( COUNTROWS ( fact_price ), NOT ISBLANK ( fact_price[dq_flags] ) ) + 0
// format: #,0

% Usable =
DIVIDE ( [Records Included], [Total Raw Records] )
// format: 0.0%

Rows Flagged (checks) =
SUM ( dq_check_summary[rows_flagged] )
// format: #,0

Issues Logged =
COUNTROWS ( dq_issue_log )
// format: #,0


// ---------- 7 Spike monitor ----------
Spikes This Week =
CALCULATE ( COUNTROWS ( price_spikes ), price_spikes[is_this_week] = 1, price_spikes[spike_type] = "spike up" ) + 0
// format: #,0

Sharp Drops This Week =
CALCULATE ( COUNTROWS ( price_spikes ), price_spikes[is_this_week] = 1, price_spikes[spike_type] = "sharp drop" ) + 0
// format: #,0

Commodities Ready =
CALCULATE ( COUNTROWS ( history_depth ), history_depth[spike_detection_status] = "ready" ) + 0
// format: #,0

Daily History (days) =
MAX ( history_depth[daily_steps] ) + 0
// format: #,0
